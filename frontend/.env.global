# Global Production Environment Variables for Frontend
# Copy this file to .env and update with your actual values

# API Configuration
REACT_APP_API_URL=https://api.yourdomain.com
REACT_APP_API_URL_PROD=https://api.yourdomain.com

# Environment
NODE_ENV=production
GENERATE_SOURCEMAP=false

# Analytics
REACT_APP_GA_ID=GA-XXXXXXXXX

# Feature Flags
REACT_APP_ENABLE_ANALYTICS=true
REACT_APP_ENABLE_SENTRY=true

# Sentry Configuration
REACT_APP_SENTRY_DSN=your-frontend-sentry-dsn

# Application Configuration
REACT_APP_APP_NAME=Universal Business Automation
REACT_APP_VERSION=1.0.0
REACT_APP_SUPPORT_EMAIL=support@yourdomain.com

# File Upload Limits
REACT_APP_MAX_FILE_SIZE=16777216  # 16MB
REACT_APP_ALLOWED_FILE_TYPES=pdf,doc,docx,ppt,pptx,jpg,jpeg,png,bmp,tiff

# Session Configuration
REACT_APP_SESSION_TIMEOUT=3600000  # 1 hour in milliseconds

# CDN Configuration (if using CDN)
REACT_APP_CDN_URL=https://cdn.yourdomain.com
