# Global Production Environment Variables
# Copy this file to .env and update with your actual values

# Flask Configuration
FLASK_APP=app:app
FLASK_ENV=production
SECRET_KEY=your-super-secure-global-secret-key-change-this-immediately

# Database Configuration (Cloud)
# For PostgreSQL on cloud platforms
DATABASE_URL=postgresql://username:password@host:port/database

# CORS Configuration (Global)
CORS_ORIGINS="https://yourdomain.com,https://www.yourdomain.com,https://app.yourdomain.com"

# File Uploads
UPLOAD_FOLDER=uploads
OUTPUT_FOLDER=outputs
MAX_CONTENT_LENGTH=16777216  # 16MB in bytes

# AWS S3 Configuration (for file storage)
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_S3_BUCKET=your-s3-bucket-name
AWS_REGION=us-east-1

# Email Configuration (Global)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=your-email@yourdomain.com
MAIL_PASSWORD=your-app-specific-password

# Redis Configuration (for caching/sessions)
REDIS_URL=redis://username:password@host:port

# Security Settings
JWT_SECRET_KEY=your-jwt-secret-key
JWT_ACCESS_TOKEN_EXPIRES=3600

# Monitoring/Logging
SENTRY_DSN=your-sentry-dsn-for-error-tracking
LOG_LEVEL=INFO

# Rate Limiting
RATELIMIT_STORAGE_URL=redis://username:password@host:port
RATELIMIT_DEFAULT=200 per day, 50 per hour

# Analytics (optional)
GOOGLE_ANALYTICS_ID=GA-XXXXXXXXX

# Production Settings
DEBUG=False
TESTING=False
DEVELOPMENT=False
PRODUCTION=True

# Domain Configuration
FRONTEND_URL=https://yourdomain.com
BACKEND_URL=https://api.yourdomain.com
